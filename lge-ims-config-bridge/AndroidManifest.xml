<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 LineageOS — caymanslm port
SPDX-License-Identifier: Apache-2.0

LgeImsConfigBridge — applies per-SIM IMS feature toggles on LineageOS.

Service (LgeImsConfigBridgeService):
  * On boot and SubscriptionsChanged: applies per-ICCID user override
    (or defaults) via AOSP ImsMmTelManager API + Settings.Global keys
    (volte_vt_enabled, enhanced_4g_lte_mode_enabled, wfc_ims_enabled).
  * Sends sticky com.lge.action.VOLTE_CHANGED_INFO matching stock LG
    wire format (cosmetic / interop with Ims6.StateInfoChangedReceiver).
  * Sets globals persist.product.lge.ims.volte_open=1 and
    persist.vendor.lge.ims.dualvolte=1 unconditionally — these ARE
    required for the LG IMS stack to start at all.

Activity (MainActivity):
  * Per-active-SIM card with checkboxes for VoLTE/ViLTE/VoWiFi/ViWiFi/RCS.
  * Apply persists override keyed by ICCID. Reset removes override.
  * Service is kicked via startService() to apply immediately.

Receiver (VoConfigUpdateReceiver):
  * Passive interop with stock LG's com.lge.action.ACTION_VO_CONFIG_UPDATE
    protocol — re-imports /data/shared/cust/config/vo_config.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.lineageos.lgeimsconfigbridge"
          android:versionCode="16"
          android:versionName="1.15"
          android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Required by ImsMmTelManager.setVoLte/Vt/VoWiFiSettingEnabled
         on Android 14+. Granted automatically to platform-signed apps. -->
    <uses-permission android:name="android.permission.PERFORM_IMS_SINGLE_REGISTRATION" />

    <!--
    Declare our two LG broadcasts as protected so AOSP's
    BroadcastController.checkBroadcastFromSystem does not log a wtf
    every time we sendStickyBroadcast. The action strings are exactly
    the ones Ims6.app.StateInfoChangedReceiver subscribes to. Only
    apps with sharedUserId=android.uid.system + platform certificate
    can register protected-broadcast actions; we satisfy both.
    Stock LG does the same declaration in framework.jar's manifest.
    -->
    <protected-broadcast android:name="com.lge.action.VOLTE_CHANGED_INFO" />
    <protected-broadcast android:name="com.lge.action.RCS_CHANGED_INFO" />
    <protected-broadcast android:name="com.lge.action.ACTION_VO_CONFIG_UPDATE" />
    <!--
    Re-emitted to feed Ims6's legacy SIMStateAgent.SIMStateReceiverListener
    which expects the pre-Android-13 broadcast format. AOSP TelephonyRegistry
    on Android 15 stopped emitting it; we replay it whenever SubscriptionManager
    reports an active sub. Stock LG framework declared this protected; we
    mirror that so AOSP BroadcastController doesn't wtf.
    -->
    <protected-broadcast android:name="android.intent.action.SIM_STATE_CHANGED" />

    <application android:label="@string/app_name"
                 android:directBootAware="true"
                 android:persistent="true"
                 android:theme="@style/AppTheme"
                 android:enabled="true">

        <!--
        com.qualcomm.qcrilhook contains the AIDL stubs (IQcrilMsgTunnel,
        IOemHookCallback) we use to bind QcrilMsgTunnelService directly.
        We bypass the stock LG lgsvcitems route because it goes through
        TelephonyManager.invokeOemRilRequestRaw which AOSP removed in
        Android 15. Both jars live in /system_ext/framework/.
        -->
        <uses-library android:name="com.qualcomm.qcrilhook"
                      android:required="true" />

        <activity android:name=".MainActivity"
                  android:label="@string/app_name"
                  android:exported="true"
                  android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".LgeImsConfigBridgeService"
                 android:exported="false"
                 android:directBootAware="true" />

        <receiver android:name=".BootReceiver"
                  android:exported="true"
                  android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
        Passive interop receiver: anything in the system that uses
        stock LG's protocol (write /data/shared/cust/config/vo_config.xml
        + sticky com.lge.action.ACTION_VO_CONFIG_UPDATE) gets picked up
        here and routed through the service for XML import + sync.
        Stock firmware processes this in framework.jar's
        ImsRadioConfigManager; LineageOS doesn't import that class, so
        we receive it ourselves.
        -->
        <receiver android:name=".VoConfigUpdateReceiver"
                  android:exported="true"
                  android:directBootAware="true">
            <intent-filter>
                <action android:name="com.lge.action.ACTION_VO_CONFIG_UPDATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
