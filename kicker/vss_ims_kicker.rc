#
# Start vss_ims_kicker as a vendor HAL-class daemon. It runs in the same
# system/radio group set as the LG vss_ims HAL service so it can talk to
# hwbinder freely.

service vendor.vss_ims_kicker /vendor/bin/hw/vss_ims_kicker
    class hal
    user system
    group system net_raw radio
    capabilities NET_BIND_SERVICE
    oneshot

# Give the vss_ims HAL a brief head-start: it is in class "hal" too but we
# don't want to race with its registerAsService(). After QMI_DAEMON_STATUS
# is up the modem-side LGE QMI service is ready and the kicker can connect.
on property:vendor.ims.QMI_DAEMON_STATUS=1
    start vendor.vss_ims_kicker
