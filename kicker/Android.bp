cc_binary {
    name: "vss_ims_kicker",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vss_ims_kicker.rc"],

    srcs: ["vss_ims_kicker.cpp"],

    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "vendor.lge.hardware.vss_ims@1.0",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
