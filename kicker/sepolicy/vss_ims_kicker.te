#
# Domain for /vendor/bin/hw/vss_ims_kicker. Needs to talk to hwservicemanager
# (binder lookup of vendor.lge.hardware.vss_ims@1.0::IVssIms) and to the
# vss_ims HAL itself over hwbinder. We also need binder_service so the HAL
# can hold our IVssImsCallback without losing the connection on permission
# checks.

type vss_ims_kicker, domain;
type vss_ims_kicker_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vss_ims_kicker)

# hwbinder + look up HAL services
hwbinder_use(vss_ims_kicker)
hal_client_domain(vss_ims_kicker, hal_vssims)
get_prop(vss_ims_kicker, vendor_default_prop)

# Allow Binder callbacks back into us
binder_call(vss_ims_kicker, hal_vssims_default)
binder_service(vss_ims_kicker)

# Logging
allow vss_ims_kicker proc:file r_file_perms;
allow vss_ims_kicker self:capability { net_bind_service };
