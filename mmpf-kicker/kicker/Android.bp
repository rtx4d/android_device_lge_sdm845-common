cc_binary {
    name: "mmpf_kicker",
    system_ext_specific: true,
    init_rc: ["mmpf_kicker.rc"],

    srcs: ["mmpf_kicker.cpp"],

    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "libdl",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
