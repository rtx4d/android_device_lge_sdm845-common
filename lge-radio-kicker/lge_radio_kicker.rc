#
# lge_radio_kicker — fire RIL_REQUEST_DATA_PDN_THROTTLE_IND_REPORT enable=false
# once at boot to mirror the stock LG framework path.
#
# Runs as oneshot in the hal class so it shares startup ordering with
# vendor.lge-vss_ims-hal-1-0 and qcrild. The actual call only happens after
# qcrild has registered ILgeRadio/lge_radio with hwservicemanager — kicker
# retries with 2s spacing until it appears.

service vendor.lge_radio_kicker /vendor/bin/hw/lge_radio_kicker
    class hal
    user system
    group system net_raw radio
    capabilities NET_BIND_SERVICE
    oneshot
    disabled

# qcrild publishes ILgeRadio after RIL_register completes. By the time
# vendor.ims.QMI_DAEMON_STATUS=1 is set, qcrild itself is already running
# and ILgeRadio is registered, so this trigger fires once per boot.
on property:vendor.ims.QMI_DAEMON_STATUS=1
    start vendor.lge_radio_kicker
